# Copy to .env.helmfile (gitignored). Used by helmfile template/apply.
# TRAEFIK_BASICAUTH_HASH is a bcrypt htpasswd hash, not the password.
# Generate: python3 -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
export TRAEFIK_BASICAUTH_USER=admin
export TRAEFIK_BASICAUTH_HASH='$2b$10$replace_me'
