# Copy to telegram.local.yaml (gitignored) in this directory.
# helmfile loads values/kube-prometheus-stack/telegram.local.yaml when present.
#
# 1. Create a bot with @BotFather and copy the token.
# 2. Get chat_id (user, group, or channel). Groups/channels are negative.
# 3. helmfile -f helmfile/helmfile.yaml sync
#
# Helm list merge is replace: keep both receivers so Watchdog still hits "null".
# Keep the message block too — a local overlay without it would fall back to the
# default label dump.

alertmanager:
  config:
    receivers:
      - name: "null"
      - name: telegram
        telegram_configs:
          - bot_token: "000000000:REPLACE_WITH_TELEGRAM_BOT_TOKEN"
            chat_id: 0
            parse_mode: HTML
            send_resolved: true
            disable_notifications: false
            # Same Alertmanager Go template as telegram.yaml (list merge replaces receivers).
            message: |-
              {{ if eq .Status "firing" }}🔥 <b>Alerts Firing</b>{{ else }}✅ <b>Alerts Resolved</b>{{ end }}
              {{- range .Alerts }}
              —————
              <b>{{ .Labels.alertname }}</b>
              {{- if or .Labels.severity .Labels.service }}
              {{ if .Labels.severity }}{{ if eq .Labels.severity "critical" }}🚨{{ else if eq .Labels.severity "warning" }}⚠️{{ else if eq .Labels.severity "info" }}ℹ️{{ else }}⚪{{ end }} <code>{{ .Labels.severity }}</code>{{ end }}{{ if .Labels.service }}{{ if .Labels.severity }} · {{ end }}<code>{{ .Labels.service }}</code>{{ end }}
              {{- end }}
              {{- if .Annotations.summary }}
              📌 <b>Summary:</b> {{ .Annotations.summary }}
              {{- end }}
              {{- if .Annotations.description }}
              {{ .Annotations.description }}
              {{- end }}
              {{- if .Annotations.runbook_url }}
              📖 Runbook: <a href="{{ .Annotations.runbook_url | safeUrl }}">click-me</a>
              {{- end }}
              {{- if .GeneratorURL }}
              🔗 Source: <a href="{{ .GeneratorURL | safeUrl }}">click-me</a>
              {{- end }}
              {{- end }}
