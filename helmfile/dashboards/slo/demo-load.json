      "targets": [
        {
          "expr": "1 - (sum(rate(demo_http_requests_total{namespace=\"demo\",code=~\"5..\"}[5m])) / clamp_min(sum(rate(demo_http_requests_total{namespace=\"demo\"}[5m])), 1e-9))",
          "legendFormat": "SLI success rate",
          "refId": "A"
