    {
      "id": 6,
      "type": "timeseries",
      "title": "SLI vs SLO (error rate)",
      "description": "Красная линия — SLO 1%. Во время k6 линия SLI должна быть около 5%.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(demo_http_requests_total{namespace=\"demo\",code=~\"5..\"}[5m])) / clamp_min(sum(rate(demo_http_requests_total{namespace=\"demo\"}[5m])), 1e-9)",
          "legendFormat": "SLI error rate",
          "refId": "A"
        },
        {
          "expr": "vector(0.01)",
          "legendFormat": "SLO 1%",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SLO 1%"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
